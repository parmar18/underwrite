{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [{ "source": "/api/:route(.*)", "destination": "/api/index?route=:route" }],
  "functions": {
    "api/index.js": {
      "includeFiles": "{data/processed/**,pipeline/sources.json}",
      "maxDuration": 300
    }
  }
}
